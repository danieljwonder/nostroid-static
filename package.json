{
  "name": "nostroid-static",
  "version": "0.2.0-dev",
  "description": "Nostr is your CMS. A site that never changes, reading your relays. Optional server layer for speed and SEO.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/core.test.js test/relay.test.js test/server.test.js",
    "build:browser": "node scripts/build-browser.js",
    "build:site-worker": "node scripts/build-worker.js site",
    "build:relay-worker": "node scripts/build-worker.js relay",
    "check": "node scripts/crawl-check.js"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "nostr-tools": "2.26.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
